            "help": {
              "es": "Nombre de variable sin {}",
              "en": "Variable name without {}",
              "pr": "Nome da variabel em chaves {}"
            },
            "remove_vars": true,
            "id": "var_",
            "css": "col-md-6"
          },
          {
