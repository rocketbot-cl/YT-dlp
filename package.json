        "title_options": "Selecione uma opção",
        "options": null
      },
      "form": {
        "css": "modal-lg",
        "inputs": [
          {
            "type": "input",
            "placeholder": "https://www.youtube.com/watch?v=PnMMBJiT338",
            "title": {
              "es": "URL:",
              "en": "URL:",
              "pr": "URL:"
            },
            "description": {
              "es": "Enlace completo del video a descargar.",
