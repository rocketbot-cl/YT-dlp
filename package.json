        "title_options": "Select Option",
        "options": null
      },
      "es": {
        "title": "Descargar Video",
        "description": "Descarga un video desde una URL, permitiendo definir calidad, proxy y ruta de salida.",
        "title_options": "Seleccione una opción",
        "options": null
      },
      "pr": {
        "title": "Baixar Vídeo",
